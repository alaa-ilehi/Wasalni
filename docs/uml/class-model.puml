@startuml
title Wasalni - modèle de classes (UC1, UC2, UC3, UC5, UC6, UC7, UC8, UC9, UC11)

skinparam classAttributeIconSize 0

package "internal/domain" {
  enum Sexe {
    MALE
    FEMALE
    OTHER
  }

  enum StatutTrajet {
    PUBLISHED
    COMPLETED
  }

  enum StatutReservation {
    ACTIVE
    CANCELLED
  }

  class Profil {
    Identifiant : string
    Nom : string
    Age : int
    Sexe : Sexe
    Photo : string
    CreeLe : time.Time
    MajLe : time.Time
    Valider() : error
  }

  interface ProfilRepository {
    Enregistrer(ctx, Profil) : (Profil, bool, error)
    ParIdentifiant(ctx, identifiant) : (Profil, error)
  }

  class CriteresRecherche {
    Origine : string
    Destination : string
    Date : string
    Limite : int
    Apres : string
  }

  class PageTrajets {
    Trajets : []Trajet
    CurseurSuivant : string
  }

  class Trajet {
    Identifiant : string
    Conducteur : string
    Origine : string
    Destination : string
    Depart : time.Time
    PlacesTotal : int
    Places : int
    Prix : float64
    DelaiAnnulation : time.Duration
    Statut : StatutTrajet
    CreeLe : time.Time
    Valider() : error
    ValiderPublication(maintenant) : error
    ValiderTerminaison(conducteur) : error
    ResteAvantDepart(maintenant) : time.Duration
  }

  interface TrajetRepository {
    Publier(ctx, Trajet) : (Trajet, error)
    ParIdentifiant(ctx, identifiant) : (Trajet, error)
    Rechercher(ctx, CriteresRecherche) : (PageTrajets, error)
    ParConducteur(ctx, conducteur) : ([]Trajet, error)
  }

  interface TrajetFinRepository {
    Terminer(ctx, identifiant, conducteur) : (Trajet, error)
  }

  interface TrajetGestionRepository {
    Modifier(ctx, Trajet, conducteur) : (Trajet, error)
    Supprimer(ctx, identifiant, conducteur) : error
  }

  class Reservation {
    Identifiant : string
    Trajet : string
    Passager : string
    Statut : StatutReservation
    CreeLe : time.Time
    Valider() : error
    ValiderAnnulation(passager, Trajet, maintenant) : error
  }

  interface ReservationRepository {
    Reserver(ctx, Reservation) : (Reservation, error)
    ParPassager(ctx, passager) : ([]Reservation, error)
    Annuler(ctx, identifiant, passager, maintenant) : (Reservation, error)
  }

  class Evaluation {
    Identifiant : string
    Trajet : string
    Evaluateur : string
    Cible : string
    Note : int
    Commentaire : string
    CreeLe : time.Time
    Valider() : error
  }

  interface EvaluationRepository {
    Enregistrer(ctx, Evaluation) : (Evaluation, error)
    Moyenne(ctx, identifiant) : (float64, int, error)
  }

  class Erreurs <<sentinelles>> {
    ErrNomRequis
    ErrNomInvalide
    ErrAgeInvalide
    ErrSexeInvalide
    ErrProfilIntrouvable
    ErrTrajetInvalide
    ErrTrajetIntrouvable
    ErrTrajetNonProprietaire
    ErrTrajetDejaTermine
    ErrTrajetSupprime
    ErrPlacesInsuffisantes
    ErrTrajetComplet
    ErrReservationIntrouvable
    ErrReservationDejaActive
    ErrReservationDejaAnnulee
    ErrAnnulationHorsDelai
    ErrConducteurNePeutPasReserver
    ErrEvaluationInvalide
    ErrTrajetNonTermine
    ErrNonParticipant
    ErrEvaluationDejaFaite
  }

  note right of Profil
    Nom : 2 à 80 caractères, espaces retirés
    Age : 18 à 99
    Sexe : MALE, FEMALE, OTHER ou vide
    Photo : base64 d'un WebP déjà normalisé, ou vide
  end note

  note right of Trajet
    Origine et destination obligatoires et différentes
    Places = PlacesTotal à la publication
    Prix >= 0, depart strictement futur
    DelaiAnnulation >= 0, defaut 2 h, < temps restant
    Places consommées atomiquement à la réservation (ADR 0004)
    Réservation et compteur modifiés dans la même transaction
    UC9 : places >= réservations actives (ErrPlacesInsuffisantes)
  end note

  note right of Evaluation
    Note entière de 1 à 5
    Évaluateur et cible distincts, tous deux participants
    Une seule évaluation par couple et par trajet (index unique)
  end note

  class Credential {
    Identifiant : string
    Sel : []byte
    Condensat : []byte
    Iterations : int
  }

  note right of Credential
    Sel aléatoire de 16 octets, unique par compte
    Condensat = PBKDF2-HMAC-SHA256(mot de passe, sel, iterations)
    Iterations stockées par ligne : le coût peut augmenter
    sans invalider les comptes existants (ADR 0011)
  end note

  class Session {
    Jeton : string
    Identifiant : string
    CreeeLe : time.Time
    ExpireLe : time.Time
  }

  note right of Session
    Jeton opaque de 32 octets (base64url)
    Seule son empreinte SHA-256 est persistée
    Durée de vie 24 h, purge paresseuse à la lecture
  end note

  interface CredentialRepository {
    Enregistrer(ctx, Credential) : error
    ParIdentifiant(ctx, identifiant) : (Credential, error)
  }

  interface SessionRepository {
    Creer(ctx, Session) : error
    ParJeton(ctx, jeton, maintenant) : (Session, error)
    Supprimer(ctx, jeton) : error
  }

package "internal/application" {
  interface NormaliseurPhoto {
    Normaliser(photoBase64) : (string, error)
  }

  class SaisieProfil {
    Nom : string
    Age : int
    Sexe : string
    Photo : *string
  }

  note right of SaisieProfil
    Photo absent (nil) : la photo existante est conservée
    Photo "" : la photo est effacée
    sinon : la valeur est normalisée
  end note

  class GererProfil {
    profils : ProfilRepository
    photos : NormaliseurPhoto
    Consulter(ctx, identifiant) : (Profil, error)
    Enregistrer(ctx, identifiant, SaisieProfil) : (Profil, bool, error)
  }

  interface Horloge {
    Maintenant() : time.Time
  }

  class SaisieTrajet {
    Origine : string
    Destination : string
    Depart : string
    DepartSecours : string
    PlacesTotal : int
    Prix : float64
    DelaiAnnulation : *float64
  }

  note right of SaisieTrajet
    Clés JSON : origin, destination, departure_time,
    seats_total, price, cancel_delay_hours
    departure = alias de departure_time
    DelaiAnnulation absent = 2 h par defaut
  end note

  class PublierTrajet {
    trajets : TrajetRepository
    horloge : Horloge
    Executer(ctx, conducteur, SaisieTrajet) : (Trajet, error)
  }

  class RechercherTrajets {
    trajets : TrajetRepository
    Executer(ctx, CriteresRecherche) : (PageTrajets, error)
  }

  note right of RechercherTrajets
    Critères vides acceptés (filtres et limite par défaut)
    Date au format AAAA-MM-JJ ; invalide : ErrRechercheInvalide (400)
    Limite bornée à 200 ; curseur illisible : ErrCurseurInvalide (400)
    Seuls les trajets PUBLISHED sont rendus, triés par départ puis identifiant
    Page de 50 trajets au plus ; CurseurSuivant vide sur la dernière page
  end note

  interface Notificateur {
    NotifierReservation(ctx, Reservation) : error
  }

  class ReserverPlace {
    trajets : TrajetRepository
    reservations : ReservationRepository
    notifications : Notificateur
    Executer(ctx, trajetID, passager) : (Reservation, error)
  }

  interface NotificateurAnnulation {
    NotifierAnnulation(ctx, Reservation) : error
  }

  class AnnulerReservation {
    reservations : ReservationRepository
    horloge : Horloge
    notificateur : NotificateurAnnulation
    Executer(ctx, passager, reservationID) : (Reservation, error)
  }

  interface NotificateurFinTrajet {
    NotifierFinTrajet(ctx, Trajet) : error
  }

  class TerminerTrajet {
    trajets : TrajetFinRepository
    notificateur : NotificateurFinTrajet
    Executer(ctx, conducteur, trajetID) : (Trajet, error)
  }

  interface NotificateurGestionTrajet {
    NotifierModificationTrajet(ctx, Trajet) : error
    NotifierSuppressionTrajet(ctx, Trajet) : error
  }

  class GererTrajet {
    depot : TrajetGestionRepository
    lecture : TrajetRepository
    horloge : Horloge
    notif : NotificateurGestionTrajet
    Modifier(ctx, conducteur, id, SaisieTrajet) : (Trajet, error)
    Supprimer(ctx, conducteur, id) : error
  }

  note right of GererTrajet
    Réservé au conducteur du trajet (ErrTrajetNonProprietaire)
    Trajet terminé : refus (ErrTrajetDejaTermine)
    Suppression logique : réservations annulées
    dans la même transaction (ADR 0004)
  end note

  class DetailTrajet {
    Trajet : Trajet
    Profil : *Profil
    Note : *float64
  }

  note right of DetailTrajet
    Profil nil : conducteur sans profil (UC8 facultatif)
    Note nil : aucune évaluation reçue (UC6)
  end note

  class ConsulterTrajet {
    trajets : TrajetRepository
    profils : ProfilRepository
    evaluations : EvaluationRepository
    Executer(ctx, identifiant) : (DetailTrajet, error)
  }

  class EvaluerParticipant {
    trajets : TrajetRepository
    reservations : ReservationRepository
    evaluations : EvaluationRepository
    Executer(ctx, evaluateur, trajetID, cible, note, commentaire) : (Evaluation, error)
  }

  note right of EvaluerParticipant
    Trajet COMPLETED requis (ErrTrajetNonTermine)
    Les deux parties doivent avoir une réservation
    Ligne annulée acceptée : participation antérieure
  end note

  class Authentification {
    credentials : CredentialRepository
    sessions : SessionRepository
    hacheur : HacheurMotDePasse
    horloge : Horloge
    Inscrire(ctx, identifiant, motDePasse) : (string, error)
    Connecter(ctx, identifiant, motDePasse) : (string, error)
    Deconnecter(ctx, jeton) : error
    Resoudre(ctx, jeton) : (string, error)
  }

  class MesTrajets {
    trajets : TrajetRepository
    Executer(ctx, conducteur) : ([]Trajet, error)
  }

  class MesReservations {
    reservations : ReservationRepository
    trajets : TrajetRepository
    Executer(ctx, passager) : ([]ReservationSuivie, error)
  }

  note right of MesReservations
    RéservationSuivie joint le trajet quand il est encore
    lisible ; trajet supprimé (UC9) : jointure nulle
    Une liste vide n'est pas une erreur (A2 de UC10)
  end note

  interface HacheurMotDePasse {
    Hacher(motDePasse) : (Credential, error)
    Verifier(motDePasse, Credential) : bool
  }

  note right of Authentification
    Inscription : 201, identifiant déjà pris → ErrIdentifiantDejaInscrit (409)
    Connexion : 200, identifiant inconnu ou mot de passe faux
      → ErrIdentifiantsInvalides (401), message unique
    Jeton : 32 octets base64url, rendu une fois, stocké haché
    DuréeSession = 24 h ; jeton expiré → ErrSessionInvalide (401)
  end note

package "internal/infrastructure/sqlite" {
  class "ProfilRepository\n(adaptateur SQLite)" as SqliteProfilRepository {
    db : *sql.DB
    Enregistrer(ctx, Profil) : (Profil, bool, error)
    ParIdentifiant(ctx, identifiant) : (Profil, error)
  }

  class "TrajetRepository\n(adaptateur SQLite)" as SqliteTrajetRepository {
    db : *sql.DB
    Publier(ctx, Trajet) : (Trajet, error)
    ParIdentifiant(ctx, identifiant) : (Trajet, error)
    Rechercher(ctx, CriteresRecherche) : (PageTrajets, error)
    Terminer(ctx, identifiant, conducteur) : (Trajet, error)
    Modifier(ctx, Trajet, conducteur) : (Trajet, error)
    Supprimer(ctx, identifiant, conducteur) : error
  }

  class "ReservationRepository\n(adaptateur SQLite)" as SqliteReservationRepository {
    db : *sql.DB
    Reserver(ctx, Reservation) : (Reservation, error)
    ParPassager(ctx, passager) : ([]Reservation, error)
    Annuler(ctx, identifiant, passager, maintenant) : (Reservation, error)
  }

  class "EvaluationRepository\n(adaptateur SQLite)" as SqliteEvaluationRepository {
    db : *sql.DB
    Enregistrer(ctx, Evaluation) : (Evaluation, error)
    Moyenne(ctx, identifiant) : (float64, int, error)
  }

  note right of SqliteReservationRepository
    BEGIN IMMEDIATE
    UPDATE rides.seats_available -= 1 (réservation)
    UPDATE bookings.status = CANCELLED
    UPDATE rides.seats_available += 1
    COMMIT atomique
  end note

  class SqliteCredentialRepository {
    Enregistrer(ctx, Credential) : error
    ParIdentifiant(ctx, identifiant) : (Credential, error)
  }

  class SqliteSessionRepository {
    Creer(ctx, Session) : error
    ParJeton(ctx, jeton, maintenant) : (Session, error)
    Supprimer(ctx, jeton) : error
  }

  class Ouverture <<fonctions>> {
    Ouvrir(ctx, chemin) : (*sql.DB, error)
    AppliquerSchema(ctx, db) : error
  }

  note right of SqliteTrajetRepository
    table rides, INSERT … RETURNING created_at
    CHECK sur places, prix, delai et statut
    lecture par identifiant et recherche (UC2)
  end note

  note right of Ouverture
    PRAGMA journal_mode = WAL
    PRAGMA busy_timeout = 5000
    PRAGMA foreign_keys = ON
    tables users, rides, bookings, ratings,
    credentials et sessions
    (CREATE TABLE IF NOT EXISTS)
  end note
}

package "internal/infrastructure/photos" {
  class Normaliser <<fonction>> {
    Normaliser(photoBase64) : (string, error)
  }

  note right of Normaliser
    CoteMax 512 px, CoteMin 128 px, paliers 512/256/128
    PoidsMax 512 Kio, PixelsMax 24 Mpx
    WebP sans perte (webp-go-pure), box filter maison
  end note
}

package "internal/infrastructure/notifications" {
  class Journal {
    NotifierReservation(ctx, Reservation) : error
    NotifierAnnulation(ctx, Reservation) : error
    NotifierFinTrajet(ctx, Trajet) : error
    NotifierModificationTrajet(ctx, Trajet) : error
    NotifierSuppressionTrajet(ctx, Trajet) : error
  }
}

package "internal/api" {
  class Routes <<fonction>> {
    Routes(Deps) : http.Handler
    GET /health
    GET /profile
    PUT /profile
    GET /rides
    GET /rides/{id}
    POST /rides
    POST /rides/{id}/bookings
    POST /rides/{id}/complete
    PUT /rides/{id}
    DELETE /rides/{id}
    DELETE /bookings/{id}
    POST /rides/{id}/ratings
    POST /auth/register
    POST /auth/login
    DELETE /auth/session
    GET /me/rides
    GET /me/bookings
  }

  class identite <<fonction>> {
    identite(*http.Request, Authentification) : (string, error)
    jetonBearer(*http.Request) : (string, error)
  }

  class statutHTTP <<table unique>> {
    statutHTTP(error) : int
  }

  note right of identite
    Authorization: Bearer <jeton> obligatoire
    sur toutes les routes sauf /health et /auth/*
    jeton absent, inconnu ou expiré : ErrSessionInvalide (401)
  end note
}

package "cmd/wasalni" {
  class Racine <<main : composition>> {
    -addr, -db / WASALNI_ADDR, WASALNI_DB
  }

  class normaliseurPhoto <<adaptateur>> {
    Normaliser(photoBase64) : (string, error)
  }

  class horlogeReelle <<adaptateur>> {
    Maintenant() : time.Time
  }
}

Profil --> Sexe
Trajet --> StatutTrajet
Reservation --> StatutReservation

GererProfil ..> ProfilRepository : utilise le port
GererProfil ..> NormaliseurPhoto : utilise le port
GererProfil ..> SaisieProfil : reçoit
GererProfil ..> Profil : valide puis enregistre
PublierTrajet ..> TrajetRepository : utilise le port
PublierTrajet ..> Horloge : utilise le port
PublierTrajet ..> SaisieTrajet : reçoit
PublierTrajet ..> Trajet : valide puis publie
RechercherTrajets ..> TrajetRepository : utilise le port
RechercherTrajets ..> CriteresRecherche : reçoit
RechercherTrajets ..> Trajet : rend la liste filtrée
ReserverPlace ..> TrajetRepository : contrôle la place
ReserverPlace ..> ReservationRepository : écrit atomiquement
ReserverPlace ..> Notificateur : notifie au mieux
ReserverPlace ..> Reservation : valide
AnnulerReservation ..> ReservationRepository : annule atomiquement
AnnulerReservation ..> Horloge : lit maintenant
AnnulerReservation ..> NotificateurAnnulation : notifie au mieux
AnnulerReservation ..> Reservation : valide l'annulation
TerminerTrajet ..> TrajetFinRepository : termine le trajet
TerminerTrajet ..> NotificateurFinTrajet : journalise au mieux
TerminerTrajet ..> Trajet : valide propriétaire et état
GererTrajet ..> TrajetGestionRepository : modifie ou supprime
GererTrajet ..> TrajetRepository : relit le trajet
GererTrajet ..> Horloge : valide le nouveau départ
GererTrajet ..> NotificateurGestionTrajet : journalise au mieux
GererTrajet ..> SaisieTrajet : reçoit
GererTrajet ..> Trajet : valide propriétaire et état
ConsulterTrajet ..> TrajetRepository : lit le trajet
ConsulterTrajet ..> ProfilRepository : lit le conducteur
ConsulterTrajet ..> EvaluationRepository : lit la moyenne
ConsulterTrajet ..> DetailTrajet : compose
EvaluerParticipant ..> TrajetRepository : vérifie l'état
EvaluerParticipant ..> ReservationRepository : vérifie la participation
EvaluerParticipant ..> EvaluationRepository : écrit la note
EvaluerParticipant ..> Evaluation : valide

ProfilRepository <|.. SqliteProfilRepository
TrajetRepository <|.. SqliteTrajetRepository
TrajetFinRepository <|.. SqliteTrajetRepository
TrajetGestionRepository <|.. SqliteTrajetRepository
ReservationRepository <|.. SqliteReservationRepository
EvaluationRepository <|.. SqliteEvaluationRepository
NormaliseurPhoto <|.. normaliseurPhoto
Horloge <|.. horlogeReelle
Notificateur <|.. Journal
NotificateurAnnulation <|.. Journal
NotificateurFinTrajet <|.. Journal
NotificateurGestionTrajet <|.. Journal

SqliteProfilRepository ..> Ouverture : base ouverte
SqliteProfilRepository ..> Profil : convertit chaque ligne
SqliteProfilRepository ..> Erreurs : ErrProfilIntrouvable
SqliteTrajetRepository ..> Ouverture : base ouverte
SqliteTrajetRepository ..> Trajet : convertit chaque ligne
SqliteTrajetRepository ..> Erreurs : ErrTrajetIntrouvable, ErrPlacesInsuffisantes
SqliteReservationRepository ..> Reservation : lit et change l'état
SqliteReservationRepository ..> Erreurs : ErrReservationIntrouvable
SqliteEvaluationRepository ..> Evaluation : convertit chaque ligne
normaliseurPhoto ..> Normaliser : délègue
horlogeReelle ..> Horloge : fournit l'heure UTC
Normaliser ..> Erreurs : ErrImageIllisible, ErrImageTropLourde, ErrImageTropGrande

Routes --> GererProfil : appelle
Routes --> PublierTrajet : appelle
Routes --> RechercherTrajets : appelle
Routes --> ConsulterTrajet : appelle
Routes --> ReserverPlace : appelle
Routes --> AnnulerReservation : appelle
Routes --> TerminerTrajet : appelle
Routes --> GererTrajet : appelle
Routes --> EvaluerParticipant : appelle
Routes --> Authentification : appelle (inscription, connexion, déconnexion)
Routes --> MesTrajets : appelle (GET /me/rides)
Routes --> MesReservations : appelle (GET /me/bookings)
Routes ..> identite : résout le jeton Bearer
Routes ..> statutHTTP : traduit les erreurs
statutHTTP ..> Erreurs : errors.Is

Racine --> SqliteProfilRepository : instancie
Racine --> SqliteTrajetRepository : instancie une fois,\npartagé par UC1, UC2, UC3, UC7, UC9 et UC11
Racine --> SqliteReservationRepository : instancie
Racine --> SqliteEvaluationRepository : instancie
Racine --> normaliseurPhoto : instancie
Racine --> Authentification : instancie (hacheur PBKDF2)
Racine --> MesTrajets : instancie
Racine --> MesReservations : instancie
Racine --> SqliteCredentialRepository : instancie
Racine --> SqliteSessionRepository : instancie
Authentification --> CredentialRepository : dépend
Authentification --> SessionRepository : dépend
Authentification --> HacheurMotDePasse : dépend
SqliteCredentialRepository ..|> CredentialRepository
SqliteSessionRepository ..|> SessionRepository
Racine --> horlogeReelle : instancie
Racine --> GererProfil : câble
Racine --> PublierTrajet : câble
Racine --> RechercherTrajets : câble
Racine --> ConsulterTrajet : câble
Racine --> ReserverPlace : câble
Racine --> AnnulerReservation : câble
Racine --> TerminerTrajet : câble
Racine --> GererTrajet : câble
Racine --> EvaluerParticipant : câble
Racine --> Routes : monte le routeur
@enduml
