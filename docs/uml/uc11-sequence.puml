@startuml uc11-sequence
title UC11 - Terminer un trajet
autonumber

actor "Conducteur" as Conducteur
participant "api.Routes\nPOST /rides/{id}/complete" as API
participant "application.TerminerTrajet" as UC
participant "domain.TrajetFinRepository\n(sqlite)" as Trajets
database "rides" as DB
participant "notifications.Journal" as Notif

Conducteur -> API : POST /rides/{id}/complete\nAuthorization: Bearer <jeton>
API -> API : Resoudre(jeton)
alt identité absente
  API --> Conducteur : 401
else identité présente
  API -> UC : Executer("alice", id)
  UC -> Trajets : Terminer(id, "alice")
  Trajets -> DB : BEGIN IMMEDIATE
  Trajets -> DB : lire le trajet
  alt inconnu
    Trajets -> DB : ROLLBACK
    Trajets --> UC : ErrTrajetIntrouvable
    UC --> API : ErrTrajetIntrouvable
    API --> Conducteur : 404
  else autre propriétaire
    Trajets -> DB : ROLLBACK
    Trajets --> UC : ErrTrajetNonProprietaire
    UC --> API : ErrTrajetNonProprietaire
    API --> Conducteur : 403
  else déjà terminé
    Trajets -> DB : ROLLBACK
    Trajets --> UC : ErrTrajetDejaTermine
    UC --> API : ErrTrajetDejaTermine
    API --> Conducteur : 409
  else publié et propriétaire
    Trajets -> DB : UPDATE rides SET status = COMPLETED\nWHERE status = PUBLISHED
    Trajets -> DB : COMMIT
    Trajets --> UC : Trajet COMPLETED
    UC -> Notif : NotifierFinTrajet(...)
    note right of UC
      Événement livré au mieux après commit :
      POST JSON si WASALNI_NOTIFICATION_URL est définie,
      journal sinon (ADR 0013).
    end note
    UC --> API : Trajet COMPLETED
    API --> Conducteur : 200 + trajet
  end
end

note over DB
  Une seconde transition constate COMPLETED
  et ne change aucune donnée.
end note
@enduml
