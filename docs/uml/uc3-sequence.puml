@startuml
title UC3 Reserver une place - scenario nominal et alternatives
skinparam defaultTextAlignment left

actor Passenger
participant "HttpApi\n(app/api)" as Api
participant "BookSeat\n(app/application)" as UC
participant "RideRepository\n(port)" as Rides
participant "BookingRepository\n(port)" as Bookings
database "SQLite\n(adaptateur)" as DB
participant "NotificationPort\n(port)" as Notif

Passenger -> Api : POST /rides/{id}/bookings\nX-User
Api -> Api : extrait l'identite (actor)
alt en-tete X-User absent
  Api --> Passenger : 401 IdentityMissing
else identite presente
  Api -> UC : execute(ride_id, actor)
  UC -> Rides : get(ride_id)
  Rides --> UC : Ride | None
  alt trajet inconnu
    UC --> Api : RideNotFound
    Api --> Passenger : 404
  else passager = conducteur
    UC --> Api : DriverCannotBook
    Api --> Passenger : 400
  else
    UC -> Bookings : book_seat(ride_id, actor, clock.now())
    Bookings -> DB : BEGIN IMMEDIATE
    Bookings -> DB : UPDATE rides SET seats_available = seats_available - 1\nWHERE id = ? AND seats_available > 0
    alt 0 ligne modifiee
      Bookings -> DB : ROLLBACK
      UC --> Api : RideFull
      Api --> Passenger : 409
    else reservation active deja existante
      Bookings -> DB : INSERT booking (index unique viole)
      Bookings -> DB : ROLLBACK
      UC --> Api : DuplicateBooking
      Api --> Passenger : 409
    else place retenue
      Bookings -> DB : INSERT booking (ACTIVE)
      Bookings -> DB : COMMIT
      Bookings --> UC : Booking
      UC -> Notif : send(actor, "place retenue")
      UC --> Api : Booking
      Api --> Passenger : 201 Created (ACTIVE)
    end
  end
end
@enduml
