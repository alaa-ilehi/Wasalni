@startuml uc3-sequence
title UC3 - Réserver une place (décrément appliqué)
autonumber

actor "Passager" as Passager
participant "api.Routes\nPOST /rides/{id}/bookings" as API
participant "application.ReserverPlace" as UC
participant "domain.TrajetRepository\n(sqlite.TrajetRepository)" as Trajets
participant "domain.ReservationRepository\n(sqlite)" as Reservations
database "rides\n(seats_available)" as Rides
database "bookings\n+ index unique partiel\n+ clé étrangère rides(id)" as DB
participant "Notifications\n(port Notificateur)" as Notif

Passager -> API : POST /rides/{id}/bookings\nAuthorization: Bearer <jeton>
API -> API : Resoudre(jeton)
alt en-tête absent
  API --> Passager : 401 identité manquante
end

API -> UC : Executer(trajetId, "alice")
UC -> Trajets : ParIdentifiant(id)
alt trajet inconnu
  Trajets --> UC : ErrTrajetIntrouvable
  UC --> API : ErrTrajetIntrouvable
  API --> Passager : 404 trajet introuvable
else trajet connu
  Trajets --> UC : Trajet{conducteur, places}
  alt passager = conducteur
    UC --> API : ErrConducteurNePeutPasReserver
    API --> Passager : 400
  else seats_available = 0
    UC --> API : ErrTrajetComplet
    API --> Passager : 409 trajet complet
  else
    UC -> Reservations : Reserver(Reservation ACTIVE)
    Reservations -> DB : BEGIN IMMEDIATE
    Reservations -> Rides : UPDATE rides\nSET seats_available = seats_available - 1\nWHERE id = ? AND seats_available > 0
    alt aucune ligne modifiée
      Reservations -> DB : ROLLBACK
      Reservations --> UC : ErrTrajetComplet
      UC --> API : ErrTrajetComplet
      API --> Passager : 409 trajet complet
    else place consommée
      Reservations -> DB : INSERT INTO bookings
      alt index unique partiel violé
        DB --> Reservations : SQLITE_CONSTRAINT_UNIQUE
        Reservations -> DB : ROLLBACK (la place est rendue)
        Reservations --> UC : ErrReservationDejaActive
        UC --> API : ErrReservationDejaActive
        API --> Passager : 409 réservation déjà active
      else insertion acceptée
        DB --> Reservations : created_at
        Reservations -> DB : COMMIT
        Reservations --> UC : Reservation{id, ACTIVE}
        UC -> Notif : NotifierReservation(...)
        note right of UC
          Au mieux (ADR 0007) : un échec
          de notification ne défait pas
          la réservation déjà validée.
        end note
        UC --> API : Reservation
        API --> Passager : 201 {id, ride_id, passenger, status: ACTIVE, created_at}
      end
    end
  end
end

note over Rides, DB
  Appliqué (ADR 0004) : le décrément conditionnel et l'insertion
  partagent la transaction immédiate, donc aucune place n'est
  vendue deux fois. La clé étrangère bookings.ride_id → rides(id)
  refuse une réservation orpheline ; le contrôle de places lu par
  le cas d'usage n'est qu'un refus rapide, la base fait foi.
end note

@enduml
